# ==============================================================================
# Environment Variables Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

PROJECT_NAME="Automated Industrial Surface Defect Detection"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="production"
LOG_LEVEL="INFO"
RANDOM_SEED=42

MVTEC_DATASET_ROOT="data/mvtec_anomaly_detection"
DATABASE_PATH="artifacts/inspection_history.db"
CHECKPOINTS_DIR="artifacts/checkpoints"
PREDICTIONS_DIR="artifacts/predictions"
METRICS_DIR="reports/metrics"
REPORTS_DIR="reports/generated"

DEVICE="auto"
NUM_WORKERS=0

DEFAULT_CATEGORY="bottle"
DEFAULT_MODEL="patchcore"
DEFAULT_ANOMALY_THRESHOLD=0.50
CALIBRATION_TARGET_FPR=0.05
UNCERTAINTY_MARGIN=0.08

ENABLE_FALSE_ALARM_REDUCTION=true
MIN_COMPONENT_AREA=50
GAUSSIAN_BLUR_KERNEL=5
GAUSSIAN_BLUR_SIGMA=1.5
MORPHOLOGICAL_KERNEL=3

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_THEME_BASE="dark"
WEBCAM_INFERENCE_INTERVAL=0.5
